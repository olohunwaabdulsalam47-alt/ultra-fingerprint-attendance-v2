# Ultra Fingerprint Attendance V2 - Backend Configuration
# TEMPLATE ONLY: Never put real credentials in this file.

NODE_ENV=development
PORT=3000

# PostgreSQL connection
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME

# Allowed frontend origin
FRONTEND_ORIGIN=http://localhost:5173

# Generate a cryptographically random secret of at least 32 bytes.
# Replace this placeholder in your private server environment.
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
